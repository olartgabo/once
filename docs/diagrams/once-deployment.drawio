<mxfile host="Once" version="24.7.17"><diagram id="once-deployment" name="AWS deployment path"><mxGraphModel page="1" pageWidth="1600" pageHeight="900" grid="1" gridSize="10"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Once - public AWS deployment path" style="text;html=1;align=left;fontSize=32;fontStyle=1;fillColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="25" width="1450" height="55" /></mxCell><mxCell id="status" value="Verified public HTTPS app: Chromium workflows, business checks, PNGs and PDFs." style="text;html=1;align=left;fontSize=20;fillColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="90" width="1450" height="45" /></mxCell><mxCell id="boundary" value="Single AWS App Runner instance" style="swimlane;html=1;startSize=45;fontSize=22;fontStyle=1;strokeColor=#91ad9d;fillColor=#f8fbf8;" vertex="1" parent="1"><mxGeometry as="geometry" x="420" y="155" width="1110" height="635" /></mxCell><mxCell id="judge" value="&lt;b&gt;Judge browser&lt;/b&gt;&lt;br&gt;Fresh session; no app login&lt;br&gt;Recording, comparisons, evidence" style="rounded=1;whiteSpace=wrap;html=1;fontSize=19;strokeColor=#83958c;fillColor=#e6f0eb;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="190" width="300" height="110" /></mxCell><mxCell id="ecr" value="&lt;b&gt;Amazon ECR&lt;/b&gt;&lt;br&gt;Private, versioned container image&lt;br&gt;Pinned Playwright + bundled Chromium" style="rounded=1;whiteSpace=wrap;html=1;fontSize=19;strokeColor=#83958c;fillColor=#fff0d9;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="390" width="300" height="110" /></mxCell><mxCell id="cfn" value="&lt;b&gt;CloudFormation&lt;/b&gt;&lt;br&gt;ECR image access role&lt;br&gt;One instance; public demo caps" style="rounded=1;whiteSpace=wrap;html=1;fontSize=19;strokeColor=#83958c;fillColor=#fff0d9;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="590" width="300" height="110" /></mxCell><mxCell id="ui" value="&lt;b&gt;React + Northstar&lt;/b&gt;&lt;br&gt;Dashboard and synthetic invoice fixture&lt;br&gt;Same task; cumulative L0-L4 mutations" style="rounded=1;whiteSpace=wrap;html=1;fontSize=19;strokeColor=#83958c;fillColor=#e6f0eb;" vertex="1" parent="1"><mxGeometry as="geometry" x="470" y="220" width="430" height="110" /></mxCell><mxCell id="api" value="&lt;b&gt;Express + compiler&lt;/b&gt;&lt;br&gt;Trace provenance; ordered workflow steps&lt;br&gt;One active browser run at a time" style="rounded=1;whiteSpace=wrap;html=1;fontSize=19;strokeColor=#83958c;fillColor=#e6f0eb;" vertex="1" parent="1"><mxGeometry as="geometry" x="1030" y="220" width="450" height="110" /></mxCell><mxCell id="browser" value="&lt;b&gt;Playwright Chromium&lt;/b&gt;&lt;br&gt;Visible roles or recorded selectors&lt;br&gt;Loopback requests to Northstar only" style="rounded=1;whiteSpace=wrap;html=1;fontSize=19;strokeColor=#83958c;fillColor=#e6f0eb;" vertex="1" parent="1"><mxGeometry as="geometry" x="470" y="430" width="430" height="110" /></mxCell><mxCell id="verify" value="&lt;b&gt;Independent verifier&lt;/b&gt;&lt;br&gt;Invoice state; customer, items, terms, total&lt;br&gt;PDF signature, size, and export state" style="rounded=1;whiteSpace=wrap;html=1;fontSize=19;strokeColor=#83958c;fillColor=#e6f0eb;" vertex="1" parent="1"><mxGeometry as="geometry" x="1030" y="430" width="450" height="110" /></mxCell><mxCell id="data" value="&lt;b&gt;Instance evidence&lt;/b&gt;&lt;br&gt;Serialized JSON; PNGs and downloaded PDFs&lt;br&gt;Ephemeral when the instance is replaced" style="rounded=1;whiteSpace=wrap;html=1;fontSize=19;strokeColor=#83958c;fillColor=#e6f0eb;" vertex="1" parent="1"><mxGeometry as="geometry" x="1030" y="640" width="450" height="110" /></mxCell><mxCell id="optional" value="&lt;b&gt;Optional adapters - disabled&lt;/b&gt;&lt;br&gt;Bedrock and AgentCore live integration is unverified&lt;br&gt;Local semantic binding uses predefined equivalent labels" style="rounded=1;whiteSpace=wrap;html=1;fontSize=19;strokeColor=#83958c;fillColor=#f2f2f4;" vertex="1" parent="1"><mxGeometry as="geometry" x="470" y="640" width="430" height="110" /></mxCell><mxCell id="edge0" value="Public HTTPS" source="judge" target="ui" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#547965;fontSize=15;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge1" value="Image pull" source="ecr" target="boundary" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#547965;fontSize=15;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge2" value="Service + role" source="cfn" target="api" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#547965;fontSize=15;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge3" value="Trace / run request" source="ui" target="api" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#547965;fontSize=15;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge4" value="Browser actions" source="api" target="browser" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#547965;fontSize=15;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge5" value="Loopback UI" source="browser" target="ui" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#547965;fontSize=15;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge6" value="Outcome checks" source="api" target="verify" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#547965;fontSize=15;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge7" value="Saved state" source="verify" target="data" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#547965;fontSize=15;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge8" value="PNGs + PDF" source="browser" target="data" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#547965;fontSize=15;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="footer" value="Hosted Playwright execution is distinct from managed AWS model/browser integration. No cloud persistence is claimed." style="text;html=1;align=left;fontSize=20;fillColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="820" width="1490" height="45" /></mxCell></root></mxGraphModel></diagram></mxfile>